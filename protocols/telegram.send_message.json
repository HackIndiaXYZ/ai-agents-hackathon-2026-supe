{
  "id": "telegram.send_message",
  "version": "1.0.0",
  "domain": "telegram",
  "capability": "send_message",
  "description": "Open or focus Telegram Desktop, search for a chat, type a message, and send it.",
  "risk": "medium",
  "requires_confirmation": true,
  "parameters": {
    "contact": { "type": "string", "required": true },
    "message": { "type": "string", "required": true },
    "send": { "type": "boolean", "required": false, "default": true }
  },
  "steps": [
    {
      "id": "send_message",
      "primitive": "app_handler",
      "action": "app_engine",
      "parameters": {
        "app": "telegram",
        "operation": "send_message",
        "contact": "{{contact}}",
        "message": "{{message}}",
        "send": "{{send}}"
      }
    }
  ],
  "state_checks": ["telegram_window_visible", "contact_search_result_present", "message_input_ready"],
  "verification": ["handler_step_success", "message_sent_or_drafted"],
  "fallbacks": ["uia", "targeted_vision", "ask_user"]
}
