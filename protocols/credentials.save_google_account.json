{
  "id": "credentials.save_google_account",
  "version": "1.0.0",
  "domain": "credentials",
  "capability": "save_google_account",
  "description": "Save a Google account credential in Windows Credential Manager for browser login recovery.",
  "risk": "high",
  "requires_confirmation": true,
  "parameters": {
    "email": { "type": "string", "required": true },
    "password": { "type": "string", "required": true, "secret": true }
  },
  "steps": [
    {
      "id": "save_google_credential",
      "primitive": "windows_credential_manager",
      "action": "save_google_credentials",
      "parameters": {
        "email": "{{email}}",
        "password": "{{password}}"
      }
    }
  ],
  "state_checks": ["windows_credential_manager_available"],
  "verification": ["credential_saved"],
  "fallbacks": ["ask_user"]
}
